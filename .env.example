# Tripwire environment — names only, never real values (see code_standards.md / I5).
# Copy to .env and fill in on the VM. .env is git-ignored.

# --- Storage ---
DATABASE_PATH=
EVIDENCE_DIR=

# --- GitHub source (read-only where possible) ---
GITHUB_TOKEN_READONLY=
GITHUB_WEBHOOK_SECRET=

# --- Room / access ---
HUMAN_HANDLES=
ROOM_ID=

# --- Watcher tuning (optional; defaults shown in comments) ---
WEBHOOK_PORT=       # default 3030 — port the GitHub webhook endpoint listens on
HEARTBEAT_MS=       # default 120000 — re-check every armed loop this often
ROOM_ZONE=          # default Africa/Lagos — local zone shown beside UTC in cards

# --- Room poster: A = Switch Agent Protocol, B = Discord mention, C = Discord webhook ---
POSTER_MODE=

# Poster A (SwitchAgentPoster) — the Switch agent bridge, verified against the
# Switch source (agent protocol revision 9; WebSocket primary, SSE legacy).
# The bridge base URL is usually NOT the Gateway URL; probe it with GET /health.
SWITCH_BRIDGE_URL=
SWITCH_GATEWAY_URL=
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_REGISTRATION_TOKEN=

# Poster C (DiscordWebhookPoster)
DISCORD_WEBHOOK_URL=
